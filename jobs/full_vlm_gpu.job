#!/bin/bash

#SBATCH -p compute
#SBATCH -J vea_rcaudit
#SBATCH --cpus-per-task=4
#SBATCH --mem=32000
#SBATCH --gres=gpu:1
#SBATCH -t 0-12:00:00
#SBATCH --mail-type=END,FAIL --mail-user=riju.das@ucdconnect.ie

source /home/rdas/miniconda/etc/profile.d/conda.sh
conda activate envAU_VA
cd /home/rdas/visual-emotion-cue-audit

export HF_HOME="$PWD/.cache/huggingface"
export TORCH_HOME="$PWD/.cache/torch"
export MPLCONFIGDIR="$PWD/.cache/matplotlib"
export XDG_CACHE_HOME="$PWD/.cache"
export TOKENIZERS_PARALLELISM=false

mkdir -p "$HF_HOME" "$TORCH_HOME" "$MPLCONFIGDIR"

python -m pip install -e '.[face,vlm]' || exit 1

affective-twins doctor --config configs/emotion6_abaw80_exact_qwen25vl3b_server.json
affective-twins generate --config configs/emotion6_abaw80_exact_qwen25vl3b_server.json || exit 1
affective-twins evaluate --config configs/emotion6_abaw80_exact_qwen25vl3b_server.json || exit 1
affective-twins report --config configs/emotion6_abaw80_exact_qwen25vl3b_server.json || exit 1
