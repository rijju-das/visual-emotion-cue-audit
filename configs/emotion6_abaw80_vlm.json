{
  "seed": 42,
  "dataset": {
    "name": "Emotion6 + Aff-Wild2 AU20",
    "image_root": "../Emotional_colorTransfer/implementation/Emotion6",
    "ground_truth_csv": "../Emotional_colorTransfer/Emotion61/ground_truth.csv",
    "auxiliary_manifest": "data/abaw_au20/manifest.jsonl",
    "audit_manifest": "data/audit80/manifest.jsonl"
  },
  "run": {
    "output_dir": "runs/emotion6_abaw80_vlm_report_conditioned",
    "limit_per_class": 10,
    "grid_size": 4,
    "text_conflict": true,
    "save_all_candidates": false,
    "face_backend": "opencv",
    "matched_controls": true,
    "report_conditioned": true
  },
  "model": {
    "checkpoint": "checkpoints/resnet18_human_distribution_multitask.pt",
    "vlm_model": "HuggingFaceTB/SmolVLM-500M-Instruct",
    "enable_vlm": true,
    "vlm_local_files_only": true,
    "vlm_pair_limit_per_cue": 5,
    "vlm_cache_dir": "runs/emotion6_abaw80_vlm_report_conditioned/vlm_cache"
  },
  "assets": {
    "face_landmarker": "assets/mediapipe/face_landmarker.task",
    "face_detector_prototxt": "assets/opencv_face_detector/deploy.prototxt",
    "face_detector_model": "assets/opencv_face_detector/res10_300x300_ssd_iter_140000_fp16.caffemodel",
    "tesseract": "/opt/homebrew/bin/tesseract"
  }
}
