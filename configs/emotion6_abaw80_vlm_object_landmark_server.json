{
  "seed": 42,
  "dataset": {
    "name": "Emotion6 + Aff-Wild2 AU20",
    "image_root": "data/audit80/images",
    "ground_truth_csv": "data/audit80/manifest.jsonl",
    "audit_manifest": "data/audit80/manifest.jsonl"
  },
  "run": {
    "output_dir": "runs/emotion6_abaw80_vlm_object_landmark_server",
    "limit_per_class": 10,
    "text_conflict": true,
    "save_all_candidates": false,
    "color_backend": "maskrcnn",
    "object_score_threshold": 0.65,
    "object_mask_threshold": 0.5,
    "object_min_area_fraction": 0.01,
    "object_max_area_fraction": 0.65,
    "object_max_candidates": 8,
    "face_backend": "mediapipe",
    "matched_controls": true
  },
  "model": {
    "checkpoint": "checkpoints/resnet18_multitask.pt",
    "vlm_model": "HuggingFaceTB/SmolVLM-500M-Instruct",
    "enable_vlm": true,
    "vlm_local_files_only": false,
    "vlm_pair_limit_per_cue": 0,
    "vlm_cache_dir": "runs/emotion6_abaw80_vlm_object_landmark_server/vlm_cache"
  },
  "assets": {
    "face_landmarker": "assets/mediapipe/face_landmarker.task",
    "face_detector_prototxt": "assets/opencv_face_detector/deploy.prototxt",
    "face_detector_model": "assets/opencv_face_detector/res10_300x300_ssd_iter_140000_fp16.caffemodel",
    "tesseract": "/usr/bin/tesseract"
  }
}
